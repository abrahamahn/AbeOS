{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "identifier": "default",
  "description": "AbeOS Control Center capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "fs:allow-read",
    "fs:allow-exists",
    "fs:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "powershell", "cmd": "powershell.exe", "args": true },
        { "name": "pwsh", "cmd": "pwsh.exe", "args": true },
        { "name": "cmd", "cmd": "cmd.exe", "args": true },
        { "name": "wsl", "cmd": "wsl.exe", "args": true },
        { "name": "reg", "cmd": "reg.exe", "args": true },
        { "name": "schtasks", "cmd": "schtasks.exe", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "powershell", "cmd": "powershell.exe", "args": true },
        { "name": "pwsh", "cmd": "pwsh.exe", "args": true },
        { "name": "cmd", "cmd": "cmd.exe", "args": true },
        { "name": "wsl", "cmd": "wsl.exe", "args": true },
        { "name": "reg", "cmd": "reg.exe", "args": true },
        { "name": "schtasks", "cmd": "schtasks.exe", "args": true }
      ]
    }
  ]
}
