{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "enabled": true,
    "template": "<#70D8F8>\u03bb</> ",
    "filler": "",
    "newline": false
  },
  "continuation_prompt": {
    "template": "<#5E7080>\u2502</> "
  },
  "blocks": [
    {
      "type": "prompt",
      "style": "primary",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "background": "#4A7E9A",
          "foreground": "#0A0A0A",
          "leading_diamond": "\u256d\u2500\ue0b2",
          "properties": {
            "alpine": "\uf300",
            "arch": "\uf303",
            "centos": "\uf304",
            "debian": "\uf306",
            "elementary": "\uf309",
            "fedora": "\uf30a",
            "gentoo": "\uf30d",
            "linux": "\ue712",
            "macos": "\ue711",
            "manjaro": "\uf312",
            "mint": "\uf30f",
            "opensuse": "\uf314",
            "raspbian": "\uf315",
            "ubuntu": "\uf31c",
            "windows": "\ue70f"
          },
          "template": " {{ if .WSL }}\ue712 on {{ end }}{{ .Icon }}  "
        },
        {
          "type": "session",
          "style": "powerline",
          "background": "#5A9BB8",
          "foreground": "#0A0A0A",
          "powerline_symbol": "\ue0b0",
          "template": " {{ if .Env.WSL_DISTRO_NAME }}bash <#0A0A0A>(wsl)</>{{ else if eq .Shell \"pwsh\" }}pwsh{{ else if eq .Shell \"bash\" }}bash{{ else }}{{ .Shell }}{{ end }} "
        },
        {
          "type": "session",
          "style": "powerline",
          "background": "#4A7E9A",
          "foreground": "#0A0A0A",
          "powerline_symbol": "\ue0b0",
          "template": " \uf007 {{ .UserName }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "background": "#5A9BB8",
          "foreground": "#0A0A0A",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#0A0A0A{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#0A0A0A{{ end }}",
            "{{ if gt .Ahead 0 }}#0A0A0A{{ end }}",
            "{{ if gt .Behind 0 }}#0A0A0A{{ end }}"
          ],
          "properties": {
            "branch_template": "{{ trunc 25 .Branch }}",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }} \ue725 {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} <#0A0A0A>\uf044 {{ .Working.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} <#0A0A0A>|</>{{ end }}{{ if .Staging.Changed }} <#0A0A0A>\uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} <#0A0A0A>\ueb4b {{ .StashCount }}</>{{ end }} ",
          "trailing_diamond": "\ue0b4"
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#90DEF0",
          "properties": {
            "fetch_version": true,
            "display_mode": "always"
          },
          "template": " \ue718 {{ .Full }}"
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#F8F4B8",
          "properties": {
            "display_version": false,
            "display_virtual_env": true
          },
          "template": " \ue73c {{ .Venv }} "
        }
      ],
      "filler": "<#90DEF0>\u2500</>"
    },
    {
      "type": "prompt",
      "style": "primary",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#90DEF0",
          "properties": {
            "threshold": 500,
            "style": "roundrock"
          },
          "template": "\uf252 {{ .FormattedMs }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "background": "#5A9BB8",
          "foreground": "#0A0A0A",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "\ue0b0",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} "
        }
      ]
    },
    {
      "type": "prompt",
      "style": "secondary",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#90DEF0",
          "template": "\u2570\u2500"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#70D8F8",
          "properties": {
            "style": "full",
            "max_width": 60
          },
          "template": "<#90DEF0>{</> {{ .Path }} <#90DEF0>}</>",
          "trailing_space": true
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#70D8F8",
          "foreground_templates": ["{{ if gt .Code 0 }}#F0A890{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "template": "\u03bb "
        }
      ]
    }
  ],
  "final_space": true,
  "version": 3
}
