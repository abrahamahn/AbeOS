# ===========================
# ABEOS CLEAN .GITIGNORE
# ===========================

# ---- CORE OS ASSETS (large) ----
assets/
assets/**

.claude/
.tmp/
.playwright-mcp/

# Keep folder structure
!assets/**/.gitkeep

# ---- BINARY FILES ----
*.exe
*.msi
*.dll
*.sys
*.reg
*.vst3
*.vst
*.dylib
*.zip
*.7z
*.rar
*.iso

# (but keep scripts)
!scripts/**/*.ps1
!scripts/**/*.sh

# ---- BACKUPS ----
backups/
configs/core/backup/
configs/core/terminal/

# ---- CONTROL CENTER BUILD OUTPUT ----
control-center/node_modules/
control-center/dist/
control-center/dist-ssr/
control-center/src-tauri/target/
control-center/.claude/
control-center/.playwright-mcp/

# ---- SYSTEM / OS CACHE ----
Thumbs.db
Desktop.ini

# ---- VS Code Caches ----
configs/core/vscode/data/
configs/core/vscode/extensions/
configs/core/vscode/Cached*
configs/core/vscode/Cache*
configs/core/vscode/**/Cache*
configs/core/vscode/**/GPUCache*
configs/core/vscode/**/Code Cache*
configs/core/vscode/**/Dawn*
configs/core/vscode/**/Shared*
configs/core/vscode/**/Session*
configs/core/vscode/**/User/workspaceStorage

# Keep VS Code settings only
!configs/core/vscode/settings.json

# ---- IDEs ----
.vscode/
.idea/
*.code-workspace

# ---- TEMP ----
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ---- NODE ----
node_modules/

# ---- PYTHON ----
__pycache__/
*.pyc

# ---- MISC ----
logs/
*.log
